{
	templateId: qwerty-outbox
	templateRole: user-outbox
	category: Special
	model: Outbox
	label: Qwertylicious Profile
	description:Profile displays everything about a user, including their inbox and outbox information
	icon: inbox
	extends: ["base-social", "base-intent", "qwerty-common", "base-outbox"]
    containedBy: []
    tagPaths: ["statusMessage"]
	tagUrl:"/search?q="
	
	bundles: {
		stylesheet: {
			content-type: "text/css"
		}
	}

	schema: {
		title: User Profile
		type: object
		properties: {
			new_password: {type:"string"}
			statusMessage: {type:"string"}
			location: {type:"string"}
			data: {
				type: object
				wildcard: string
				properties: {
					tags: {type:"string"}
					background-body: {type:"string", format:"uri"}
					layout-highlight-first: {type:"boolean"}
					stylesheet: {type:"string"}
					color-button: {type:"string", format:"color"}
				}
			}
		}
	}

	states: {
		default: {
			label: Default State,
			description: This template does not use states
		}
		"WIZARD-STEP-1": {
			label: Step 1 of 3
		}
		LIVE: {
			label: Live
			description: This template is visible to all viewers
		}
	}

	// Every new profile starts with Articles and Notes, set up as qwerty-collection's create would (see AGENTS.md)
	defaultChildren: [
		{
			templateId: "qwerty-collection"
			label: "Articles"
			"data.layout": "column-3"
			"data.zoom": "11"
			"data.calendarView": "list"
			"data.timelineOrder": "asc"
			"data.episodeOrder": "desc"
			replyPolicy: "everyone"
			"groups.viewer.0": "000000000000000000000000"
		}
		{
			templateId: "qwerty-collection"
			label: "Notes"
			"data.layout": "notes"
			"data.zoom": "11"
			"data.calendarView": "list"
			"data.timelineOrder": "asc"
			"data.episodeOrder": "desc"
			replyPolicy: "everyone"
			"groups.viewer.0": "000000000000000000000000"
		}
	]

	datasets: {
		fonts: [
			{Label:"System Fonts", Value:"system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol'"}
			{Label:"Open Sans", Value:"Open Sans"}
			{Label:"Oxygen", Value:"Oxygen"}
			{Label:"Fira Sans", Value:"Fira Sans"}
			{Label:"Noto *", Value:"Noto *"}
			{Label:"Baskerville", Value:"Baskerville"}
			{Label:"Spectral", Value:"Spectral"}
			{Label:"Newsreader", Value:"Newsreader"}
			{Label:"Playfair Display", Value:"Playfair Display"}
			{Label:"Cormorant *", Value:"Cormorant *"}
			{Label:"Source Serif", Value:"Source Serif"}
		]
	}

	tagPaths: ["data.tags"]

	actions: {

		// About renders only for htmx; a direct visit redirects to the profile with ?tab=about
		about: {
			roles: ["anonymous"]
			steps:[
				{do:"if", condition:"{{.IsPartialRequest}}", then:[
					{do:"view-html"}
				], else:[
					{do:"redirect-to", url:"/@{{.UserID}}?tab=about"}
				]}
			]
		}

		// The Notes tab's + button opens this composer in a modal, which saves a Note on the profile, as Emissary's outbox-add does
		add-note: {
			roles: ["self"]
			steps: [
				{do:"set-args", postTo:"/@me/add-note"}
				{do:"set-query-param", new-stream-label:"Post"}
				{do:"as-modal", steps:[
					{do:"view-html", file:"add-note-title"}
					// A new note takes the Notes collection's reply policy (empty, which is "everyone", when there is none)
					{do:"add-stream", style:"inline", location:"outbox", template:"outbox-message", with-data:{
						replyPolicy:"{{range ((.Outbox.Where `templateId` `qwerty-collection`).Where `data.layout` `notes`).Top1.Slice}}{{.ReplyPolicy}}{{end}}"
					}}
				]}
				{do:"refresh-page"}
			]
		}

		// RULE: a profile holds up to 8 collections; past that, GET and POST both answer with a message
		add-collection: {
			roles: ["self"]
			steps: [
				{do:"if", condition:"{{ge (len (.Outbox.Where `templateId` `qwerty-collection`).Slice) 8}}", then:[
					{do:"inline-error", message:"You have 8 collections, the most a profile can hold."}
					{do:"as-modal", steps:[
						{do:"view-html", file:"collections-full"}
					]}
					{do:"halt"}
				]}
				{
					do: add-stream
					style: inline
					location: outbox
					template: qwerty-collection
					title: + Add a Collection
				}
			]
		}

		checkout: {
			roles: ["anonymous"]
			steps: [
				{do:"if", condition:"{{gt 1 .ProductCount}}", 
				then:[
					{
						do:"forward-to"
						url:"/.checkout?productId={{.Products.First.ProductID.Hex}}&return={{.Permalink}}"
						method:"get"
					}
				], 
				else:[
					{do:"as-modal", steps:[
						{do:"view-html"}
					]}
				]}
			]
		}

		create: {
			roles: ["self"]
			steps:[
				{
					do:"set-data", 
					values:{}
				}
			]
		}

		delete-icon: {
			roles: ["self"]
			steps: [
				{do:"delete-attachments", field:"iconId"}
				{do:"save"}
				{do:"search-index", if:"{{.IsIndexable}}"}
			]
		}

		delete-image: {
			roles: ["self"]
			steps: [
				{do:"delete-attachments", field:"imageId"}
				{do:"save"}
				{do:"search-index", if:"{{.IsIndexable}}"}
			]
		}

		delete-background: {
			roles: ["self"]
			steps: [
				{do:"set-data", values:{"data.background-body":""}}
				{do:"delete-attachments", category:"body-background"}
				{do:"save"}
			]
		}

		edit-status: {
			roles: ["self"]
			steps: [
				{do: "as-modal", background:"view", steps:[
					{
						do: "edit"
						form:{
							label: Edit Status Message
							type: layout-vertical
							children: [
								{type:"textarea", path:"statusMessage", description:"Displayed on your profile page. Markdown is allowed. (PUBLIC)", options:{rows:8, showLimit:true}}
							]
						}
					}
					{do:"save"}
					{do:"search-index"}
					{do:"refresh-page"}
				]}
			] 
		}

		// The profile header's empty banner posts its image here, when the owner clicks it or drops a file on it
		upload-banner: {
			roles: ["self"]
			steps: [
				{do:"upload-attachments", category:"image", fieldname:"image", attachment-path:"imageId", accept-type:"image/*", rules:{types:["webp"]}}
				{do:"save"}
				{do:"search-index", if:"{{.IsIndexable}}"}
				{do:"refresh-page"}
			]
		}

		edit-banner: {
			roles: ["self"]
			steps: [
				{do: "as-modal", background:"view", steps:[
					{
						do: "edit"
						form:{
							label: Edit Banner
							description: Choose a color or an image to display a banner on your profile.  Leave empty and it will be hidden to visitors.
							type:layout-vertical
							children: [
								{type:"colorpicker", path:"data.color-banner", label:"Background Color", description:"Displays underneath your banner image."}
								{type:"upload", path:"imageUrl", label:"Banner Image", description:"Displays at the top of your profile page.", options:{accept:"image/*", delete:"/@me/delete-image"}}
							]
						}
					}
					{do:"upload-attachments", category:"image", fieldname:"imageUrl", attachment-path:"imageId", rules:{types:["webp"]}}
					{do:"save"}
					{do:"search-index", if:"{{.IsIndexable}}"}
					{do:"refresh-page"}
				]}
			] 
		}

		follow: {
			roles: ["anonymous"]
			steps: [
				{do:"as-modal", steps:[
					{do:"view-html"}
				]}
			]
		}

		header: {
			roles: ["anonymous"]
			steps: [
				{do:"view-html", file:"profile-header"}
			]
		}

		publish: {
			roles: ["self"]
			steps: [
				{do:"as-modal", steps:[
					{do:"edit", form:{
						type:"layout-vertical"
						label:"Publish Your Profile"
						description:"This determines who can see your profile and interact with you online."
						children:[
							{type:"toggle", path:"isPublic", options:{text:"Make My Profile Public (visible to people)"}}
							{type:"toggle", path:"isIndexable", options:{text:"Make My Profile Indexable (include in search results)"}}
						]}
					}
				]}
				{do:"save"}
				{do:"search-index", if:"{{.IsIndexable}}"}
				{do:"refresh-page"}
			]
		}

		// The Collections tab of Settings → Profile, after base-outbox's Links tab
		settings-collections: {
			roles: ["self"]
			steps: [
				{do:"view-html"}
			]
		}

		// The tab's form: re-ranks the collections on POST, then answers with the form again
		settings-collections-form: {
			roles: ["self"]
			steps: [
				{do:"sort", model:"Stream", keys:"_id", values:"rank"}
				{do:"view-html", method:"both"}
			]
		}

		sort-featured: {
			roles: ["self"]
			steps: [
				{do:"sort", model:"Stream", keys:"_id", values:"rank"}
				{do:"set-header", name:"Hx-Push-Url", value:"false"}
			]
		}

		sort-children: {
			roles: ["self"]
			steps: [
				{do:"sort", model:"Stream", keys:"_id", values:"rankAlt"}
			]
		}

		stylesheet: {
			roles: ["anonymous"]
			steps: [
				{do:"view-css"}
			]
		}

		subscribe: {
			roles: ["anonymous"]
			steps: [
				{do:"as-modal", background:"view", steps:[
					{do:"view-html"}
				]}
			]
		}

		view: {
			roles: ["anonymous"]
			steps: [
				{do:"view-html", file:"outbox"}
			]
		}

		wizard-1: {
			roles: ["self"]
			steps: [
				// RULE: ask for a password only when the account has none; set-password never replaces one without the current one
				{do:"if", condition:"{{.HasPassword}}", then:[
					{
						do:edit
						form: {
							type:layout-vertical
							children: [
								{type:"text", path:"displayName", label:"Your Name", description:"Displayed publicly. The name you want to be known by.", options:{autocomplete:"name", required:true}}
								{type:"text", path:"username", label:"Username", description:"Displayed publicly. How others will find you online.", options:{autocomplete:"username", required:true}}
								{type:"upload", path:"iconUrl", label:"Avatar Image", description:"Displayed publicly next to your name, often on other websites, too.", options:{accept:"image/*"}}
							]
						}
						options: ["endpoint:/@{{.UserID}}/wizard-1", "submit-label:Continue >>", "cancel-button:hide"]
					}
				], else:[
					{
						do:edit
						form: {
							type:layout-vertical
							children: [
								{type:"text", path:"displayName", label:"Your Name", description:"Displayed publicly. The name you want to be known by.", options:{autocomplete:"name", required:true}}
								{type:"text", path:"username", label:"Username", description:"Displayed publicly. How others will find you online.", options:{autocomplete:"username", required:true}}
								{type:"password", path:"new_password", label:"Choose Your Password", description:"At least 8 characters. Please use a Password Manager.", options:{autocomplete:"new-password", minLength:8, required:true}}
								{type:"upload", path:"iconUrl", label:"Avatar Image", description:"Displayed publicly next to your name, often on other websites, too.", options:{accept:"image/*"}}
							]
						}
						options: ["endpoint:/@{{.UserID}}/wizard-1", "submit-label:Continue >>", "cancel-button:hide"]
					}
				]}
				{do:"upload-attachments", category:"icon", fieldname:"iconUrl", attachment-path:"iconId", rules:{width:400, height:400, types:["webp"]}}
				{do:"set-state", state:"LIVE"}
				{do:"set-password"}
				{do:"save"}
				{do:"set-header", name:"HX-Refresh", value:"true"}
			]
		}

	}
}