{
	templateId: qwerty-collection
	templateRole: qwerty-collection
	category: Special
	model: Stream
	containedBy: ["outbox"]
	extends: ["qwerty-common"]
	label: Qwertylicious Collection
	description: A tab on a Qwertylicious profile that groups the author's Articles, photos, places, or events
	icon: collection
	childSortType: rank
	childSortDirection: asc
	// Every item takes this collection's sharing and reply policy, and a change reaches the items on save
	shareWithChildren: true

	schema: {
		type: object
		properties: {
			label: {type:"string", maxLength:128, required:true}
			summary: {type:"string", format:"markdown", maxLength:2048}
			// "everyone" or "nobody", set by the allowReplies toggle; items inherit it with their sharing
			replyPolicy: {type:"string", enum:["", "everyone", "nobody"]}
			// Emissary's virtual toggle over replyPolicy (TRUE is "everyone"), for Edit Collection forms
			allowReplies: {type:"boolean"}
			// A Map's default center: Los Angeles at creation, then set in Edit Map
			location: {type:"object", properties: {
				name: {type:"string"}
				formatted: {type:"string"}
				latitude: {type:"number"}
				longitude: {type:"number"}
			}}
			data: {
				type: object
				properties: {
					// "notes" and "about" are magic: they show the profile's Notes or its About Me message, and hold no items (§1.7)
					layout: {type:"string", enum:["column-1", "column-2", "column-3", "row", "row-reverse", "gallery", "map", "timeline", "calendar", "podcast", "notes", "about"]}
					zoom: {type:"integer", minimum:0, maximum:19}
					// A Photo Gallery's or Article collection's order: "publishDate" (Chronological, newest first), "rank" (Custom), or the older "createDate"
					sortType: {type:"string", enum:["publishDate", "rank", "createDate"]}
					// A Podcast's episode order by rank, "desc" (newest first) or "asc"
					sortDirection: {type:"string", enum:["desc", "asc"]}
					// A Calendar's default view, "list" (the default when empty), "week", or "month"
					calendarView: {type:"string", enum:["", "list", "week", "month"]}
					// A Photo Gallery's, Article collection's, or Calendar's filters, read in order by parseTags and never through tagPaths (see AGENTS.md)
					tags: {type:"string", maxLength:1024}
				}
			}
		}
	}

	states: {
		default: {
			label: Default
			description: Visible to the people this collection is shared with
		}
	}

	roles: {
		viewer: {
			label: Viewer
			description: Can see this collection and the Articles in it
		}
	}

	actions: {

		// Add a Collection: a modal through the outbox's add-collection, which saves nothing until the form posts
		create: {
			roles: ["author"]
			steps: [
				{do:"set-data", values:{"data.layout":"column-3", "data.zoom":"11", "data.calendarView":"list", "data.sortType":"publishDate", "data.sortDirection":"desc", "replyPolicy":"everyone"}}
				{do:"as-modal", steps: [
					// A profile has at most one Notes collection, so Notes is offered only while it has none (§1.7)
					{do:"if", condition:"{{(((.ParentOutbox `view`).Outbox.Where `templateId` `qwerty-collection`).Where `data.layout` `notes`).Top1.Slice.NotEmpty}}", then:[
						{
							do: "edit"
							form: {
								type: layout-vertical
								label: "+ Add a Collection"
								children: [
									{type:"radio-button-group", path:"data.layout", options:{provider:"qwerty-collection.layoutsWithoutNotes"}}
								]
							}
						}
						// A stale form or a crafted POST saves nothing, rather than a second Notes collection
						{do:"if", condition:"{{eq (.Data `layout`) `notes`}}", then:[
							{do:"halt"}
						]}
					], else:[
						{
							do: "edit"
							form: {
								type: layout-vertical
								label: "+ Add a Collection"
								children: [
									{type:"radio-button-group", path:"data.layout", options:{provider:"qwerty-collection.layouts"}}
								]
							}
						}
					]}
					// RULE: Notes and the About Me message are always public, so those tabs are shared with everyone and have no Sharing item
					{do:"if", condition:"{{in (.Data `layout`) `notes` `about`}}", then:[
						{do:"set-sharing", role:"viewer", group:"anonymous"}
					]}
					// A new Map starts over Los Angeles at the City zoom (data.zoom 11, above); Edit Map changes both
					{do:"if", condition:"{{eq (.Data `layout`) `map`}}", then:[
						// RULE: formatted goes first, in its own step, because changing it clears the coordinates
						{do:"set-data", values:{"location.formatted":"Los Angeles, CA"}}
						{do:"set-data", values:{"location.latitude":"34.0522", "location.longitude":"-118.2437"}}
					]}
					// The form asks only for the format, so the new tab is named after it.  Edit Collection renames it.
					{do:"set-data", values:{"label":"{{with .Data `layout`}}{{if eq . `gallery`}}Photos{{else if eq . `podcast`}}Podcast{{else if eq . `timeline`}}Timeline{{else if eq . `calendar`}}Calendar{{else if eq . `map`}}Map{{else if eq . `notes`}}Notes{{else if eq . `about`}}About{{else}}Articles{{end}}{{end}}"}}
					{do:"save", comment:"Created by {{.Author}}"}
				]}
				{do:"forward-to", url:"/@{{.ParentID}}?tab={{.StreamID}}"}
			]
		}

		// A collection has no page of its own: its URL opens its tab on the owner's profile
		view: {
			roles: ["author", "viewer"]
			steps: [
				{do:"redirect-to", url:"/@{{.ParentID}}?tab={{.StreamID}}"}
			]
		}

		list: {
			roles: ["author", "viewer"]
			steps: [
				{do:"view-html"}
			]
		}

		// The next page of a Photo Gallery, loaded as the visitor scrolls (gallery-more.html)
		gallery-page: {
			roles: ["author", "viewer"]
			steps: [
				{do:"view-html", file:"items-gallery-page"}
			]
		}

		// The Notes collection holds no items, so its feed is the profile's (§1.7)
		feed: {
			roles: ["author", "viewer"]
			steps: [
				{do:"if", condition:"{{eq (.Data `layout`) `notes`}}", then:[
					{do:"redirect-to", url:"/@{{.ParentID}}/feed?format={{.QueryParam `format` | urlquery}}"}
				], else:[
					{do:"view-feed"}
				]}
			]
		}

		// The next page of the Notes tab, loaded as the visitor scrolls (notes-list.html)
		notes-page: {
			roles: ["author", "viewer"]
			steps: [
				// RULE: only the Notes collection lists the profile's Notes
				{do:"if", condition:"{{ne (.Data `layout`) `notes`}}", then:[
					{do:"halt"}
				]}
				{do:"view-html", file:"items-notes-page"}
			]
		}

		// Edit Collection: a modal holding the Delete link; a collection never changes kind (see AGENTS.md)
		settings: {
			roles: ["author"]
			steps: [
				{do:"as-modal", steps: [
					{do:"view-html", file:"settings-title"}
					{do:"switch", expression:"{{.Data `layout`}}", cases:{
						notes: {do:"include", action:"settings-notes"}
						about: {do:"include", action:"settings-about"}
						podcast: {do:"include", action:"settings-podcast"}
						gallery: {do:"include", action:"settings-photos"}
						map: {do:"include", action:"settings-map"}
						calendar: {do:"include", action:"settings-calendar"}
						timeline: {do:"include", action:"settings-timeline"}
					}, default:{do:"include", action:"settings-articles"}}
				]}
				{do:"refresh-page"}
			]
		}

		// The Notes collection has no format to change, and no children; share-reply-policy carries its replies
		settings-notes: {
			roles: ["author"]
			steps: [
				// RULE: only the Notes collection, because every settings-* action is also its own URL (see AGENTS.md)
				{do:"require", condition:"{{eq (.Data `layout`) `notes`}}"}
				{
					do: "edit"
					options: ["delete:/{{.StreamID}}/delete", "delete-label:Delete"]
					form: {
						type: layout-vertical
						children: [
							{type:"text", path:"label", label:"Name", options:{required:true, autocomplete:"off"}}
							{type:"textarea", path:"summary", label:"Description", description:"Shown at the top of your Notes.  Markdown is okay. (PUBLIC)", options:{rows:12}}
							{type:"toggle", path:"allowReplies", options:{text:"Allow Replies to all Notes in this collection"}}
						]
					}
				}
				// RULE: the Notes tab is always shared with everyone, which also repairs one shared before this rule
				{do:"set-sharing", role:"viewer", group:"anonymous"}
				{do:"save", comment:"Settings updated by {{.Author}}"}

				// Notes are not this collection's children, so its reply policy is copied onto them here
				{do:"share-reply-policy", template:"outbox-message"}
			]
		}

		// Edit About: one hand-written form for the tab's name and the profile's About Me message, which are two records (see AGENTS.md)
		settings-about: {
			roles: ["author"]
			steps: [
				// RULE: only the About collection, because every settings-* action is also its own URL (see AGENTS.md)
				{do:"require", condition:"{{eq (.Data `layout`) `about`}}"}
				{do:"view-html", file:"settings-about"}

				// RULE: set-data does not enforce the form's required name, so an empty one falls back to "About"
				{do:"set-data", from-form:["label"], defaults:{"label":"About"}}
				// RULE: the About tab is always shared with everyone, as the message it shows is
				{do:"set-sharing", role:"viewer", group:"anonymous"}
				{do:"save", comment:"Settings updated by {{.Author}}"}

				// The message belongs to the profile that owns this collection, which is the one the tab shows
				{do:"with-parent", steps:[
					{do:"set-data", from-form:["statusMessage"]}
					{do:"save", comment:"About Me updated from the About tab"}
					{do:"search-index"}
				]}
			]
		}

		// A Podcast's replies are a toggle here, and reach its episodes through shareWithChildren
		settings-podcast: {
			roles: ["author"]
			steps: [
				// RULE: only a Podcast, because every settings-* action is also its own URL (see AGENTS.md)
				{do:"require", condition:"{{eq (.Data `layout`) `podcast`}}"}
				{
					do: "edit"
					options: ["delete:/{{.StreamID}}/delete", "delete-label:Delete"]
					form: {
						type: layout-tabs
						children: [
							{
								type: layout-vertical
								label: General
								children: [
									{type:"text", path:"label", label:"Name", options:{required:true, autocomplete:"off"}}
									{type:"select", path:"data.sortDirection", label:"Sort", options:{provider:"qwerty-collection.sortDirections", required:true}}
									{type:"toggle", path:"allowReplies", options:{text:"Allow Replies to all Episodes in this collection"}}
								]
							}
							{
								type: layout-vertical
								label: Description
								children: [
									{type:"textarea", path:"summary", description:"Shown above the player, and in the podcast's feed.  Markdown is okay. (PUBLIC)", options:{rows:12}}
								]
							}
						]
					}
				}
				{do:"save", comment:"Settings updated by {{.Author}}"}
			]
		}

		// A Photo Gallery's replies are a toggle here, and reach its photos through shareWithChildren
		settings-photos: {
			roles: ["author"]
			steps: [
				// RULE: only a Photo Gallery, because every settings-* action is also its own URL (see AGENTS.md)
				{do:"require", condition:"{{eq (.Data `layout`) `gallery`}}"}
				{
					do: "edit"
					options: ["delete:/{{.StreamID}}/delete", "delete-label:Delete"]
					form: {
						type: layout-tabs
						children: [
							{
								type: layout-vertical
								label: General
								children: [
									{type:"text", path:"label", label:"Name", options:{required:true, autocomplete:"off"}}
									{type:"select", path:"data.sortType", label:"Sort", description:"Custom lets you drag photos into any order.", options:{provider:"qwerty-collection.sortTypes", required:true}}
									{type:"text", path:"data.tags", label:"#Hashtags", description:"Each one is a filter above your photos, in this order. (PUBLIC)", options:{autocomplete:"off"}}
									{type:"toggle", path:"allowReplies", options:{text:"Allow replies to all photos in this collection"}}
								]
							}
							{
								type: layout-vertical
								label: Description
								children: [
									{type:"textarea", path:"summary", description:"Shown at the top of this collection.  Markdown is okay. (PUBLIC)", options:{rows:12}}
								]
							}
						]
					}
				}
				{do:"save", comment:"Settings updated by {{.Author}}"}
			]
		}

		// A Map's replies are a toggle too, as on a Photo Gallery
		settings-map: {
			roles: ["author"]
			steps: [
				// RULE: only a Map, because every settings-* action is also its own URL (see AGENTS.md)
				{do:"require", condition:"{{eq (.Data `layout`) `map`}}"}
				{
					do: "edit"
					options: ["delete:/{{.StreamID}}/delete", "delete-label:Delete"]
					form: {
						type: layout-tabs
						children: [
							{
								type: layout-vertical
								label: General
								children: [
									{type:"text", path:"label", label:"Name", options:{required:true, autocomplete:"off"}}
									{type:"toggle", path:"allowReplies", options:{text:"Allow Replies to all Places in this collection"}}
								]
							}
							{
								type: layout-vertical
								label: Description
								children: [
									{type:"textarea", path:"summary", description:"Shown at the top of this collection.  Markdown is okay. (PUBLIC)", options:{rows:12}}
								]
							}
							{
								type: layout-vertical
								label: Location
								children: [
									// The map's starting view, the only place it is set
									{type:"place", path:"location", label:"Map Center", options:{placeholder:"Search for an address or place...", endpoint:"/.geocode/autocomplete"}}
									{type:"select", path:"data.zoom", label:"Map Zoom", options:{provider:"qwerty-collection.mapZooms"}}
								]
							}
						]
					}
				}
				{do:"save", comment:"Settings updated by {{.Author}}"}
			]
		}

		// A Calendar's replies are a toggle too, and reach its events through shareWithChildren
		settings-calendar: {
			roles: ["author"]
			steps: [
				// RULE: only a Calendar, because every settings-* action is also its own URL (see AGENTS.md)
				{do:"require", condition:"{{eq (.Data `layout`) `calendar`}}"}
				{
					do: "edit"
					options: ["delete:/{{.StreamID}}/delete", "delete-label:Delete"]
					form: {
						type: layout-tabs
						children: [
							{
								type: layout-vertical
								label: General
								children: [
									{type:"text", path:"label", label:"Name", options:{required:true, autocomplete:"off"}}
									{type:"text", path:"data.tags", label:"#Hashtags", description:"Each one is a filter above your events, in this order. (PUBLIC)", options:{autocomplete:"off"}}
									{type:"toggle", path:"allowReplies", options:{text:"Allow replies to all events in this collection"}}
								]
							}
							{
								type: layout-vertical
								label: Description
								children: [
									{type:"textarea", path:"summary", description:"Shown at the top of this collection.  Markdown is okay. (PUBLIC)", options:{rows:12}}
								]
							}
							{
								type: layout-vertical
								label: Layout
								children: [
									{type:"radio-button-group", path:"data.calendarView", options:{provider:"qwerty-collection.calendarViews"}}
								]
							}
						]
					}
				}
				{do:"save", comment:"Settings updated by {{.Author}}"}
			]
		}

		// A Timeline's replies are a toggle too, and reach its events through shareWithChildren
		settings-timeline: {
			roles: ["author"]
			steps: [
				// RULE: only a Timeline, because every settings-* action is also its own URL (see AGENTS.md)
				{do:"require", condition:"{{eq (.Data `layout`) `timeline`}}"}
				{
					do: "edit"
					options: ["delete:/{{.StreamID}}/delete", "delete-label:Delete"]
					form: {
						type: layout-tabs
						children: [
							{
								type: layout-vertical
								label: General
								children: [
									{type:"text", path:"label", label:"Name", description:"Shown as this collection's tab on your profile. (PUBLIC)", options:{required:true, autocomplete:"off"}}
									{type:"toggle", path:"allowReplies", options:{text:"Allow replies to all events in this collection"}}
								]
							}
							{
								type: layout-vertical
								label: Description
								children: [
									{type:"textarea", path:"summary", description:"Shown at the top of this collection.  Markdown is okay. (PUBLIC)", options:{rows:12}}
								]
							}
						]
					}
				}
				{do:"save", comment:"Settings updated by {{.Author}}"}
			]
		}

		// An Article collection's replies are a toggle too, and reach its Articles through shareWithChildren
		settings-articles: {
			roles: ["author"]
			steps: [
				// RULE: only an Article collection, which is every format the settings switch leaves to its default
				{do:"require", condition:"{{not (in (.Data `layout`) `notes` `about` `podcast` `gallery` `map` `calendar` `timeline`)}}"}
				{
					do: "edit"
					options: ["delete:/{{.StreamID}}/delete", "delete-label:Delete"]
					form: {
						type: layout-tabs
						children: [
							{
								type: layout-vertical
								label: General
								children: [
									{type:"text", path:"label", label:"Name", description:"Shown as this collection's tab on your profile. (PUBLIC)", options:{required:true, autocomplete:"off"}}
									{type:"select", path:"data.sortType", label:"Sort", description:"Custom lets you drag articles into any order.", options:{provider:"qwerty-collection.sortTypes", required:true}}
									{type:"text", path:"data.tags", label:"#Hashtags", description:"Each one is a filter above your articles, in this order. (PUBLIC)", options:{autocomplete:"off"}}
									{type:"toggle", path:"allowReplies", options:{text:"Allow replies to all articles in this collection"}}
								]
							}
							{
								type: layout-vertical
								label: Description
								children: [
									{type:"textarea", path:"summary", description:"Shown at the top of this collection.  Markdown is okay. (PUBLIC)", options:{rows:12}}
								]
							}
							{
								type: layout-vertical
								label: Layout
								children: [
									{type:"radio-button-group", path:"data.layout", options:{provider:"qwerty-collection.articleLayouts"}}
								]
							}
						]
					}
				}
				{do:"save", comment:"Settings updated by {{.Author}}"}
			]
		}

		sharing: {
			roles: ["author"]
			steps: [
				// RULE: Notes and the About Me message are always public, so those collections have no sharing to set
				{do:"if", condition:"{{in (.Data `layout`) `notes` `about`}}", then:[
					{do:"halt"}
				]}
				{do:"as-modal", steps: [
					// The subheading names what this format holds, as the reply toggles do
					{do:"if", condition:"{{eq (.Data `layout`) `gallery`}}", then:[
						{do:"set-circle-sharing", role:"viewer", title:"Who Can See This Collection?", message:"Select which people can see the photos in this collection."}
					], else:[
						{do:"if", condition:"{{eq (.Data `layout`) `map`}}", then:[
							{do:"set-circle-sharing", role:"viewer", title:"Who Can See This Collection?", message:"Select which people can see the places in this collection."}
						], else:[
							{do:"if", condition:"{{in (.Data `layout`) `timeline` `calendar`}}", then:[
								{do:"set-circle-sharing", role:"viewer", title:"Who Can See This Collection?", message:"Select which people can see the events in this collection."}
							], else:[
								{do:"if", condition:"{{eq (.Data `layout`) `podcast`}}", then:[
									{do:"set-circle-sharing", role:"viewer", title:"Who Can See This Collection?", message:"Select which people can see the episodes in this collection."}
								], else:[
									{do:"set-circle-sharing", role:"viewer", title:"Who Can See This Collection?", message:"Select which people can see the articles in this collection."}
								]}
							]}
						]}
					]}
					{do:"save", comment:"Sharing updated by {{.Author}}"}
				]}
				{do:"refresh-page"}
			]
		}

		// The format picks the item: qwerty-photo, qwerty-episode, qwerty-placemark, qwerty-timeline-entry, or qwerty-event through a modal form (hx-get),
		// or else an Article, created at once (hx-post)
		add: {
			roles: ["author"]
			steps: [
				// The Notes and About collections never have items; a Note is written on the profile (§1.7)
				{do:"if", condition:"{{in (.Data `layout`) `notes` `about`}}", then:[
					{do:"halt"}
				]}
				{do:"if", condition:"{{eq (.Data `layout`) `gallery`}}", then:[
					{do:"add-stream", style:"inline", location:"child", template:"qwerty-photo", title:"+ Add a Photo"}
				], else:[
					{do:"if", condition:"{{eq (.Data `layout`) `podcast`}}", then:[
						{do:"add-stream", style:"inline", location:"child", template:"qwerty-episode", title:"+ Add an Episode"}
					], else:[
						{do:"if", condition:"{{eq (.Data `layout`) `map`}}", then:[
							{do:"add-stream", style:"inline", location:"child", template:"qwerty-placemark", title:"+ Add a Place"}
						], else:[
							{do:"if", condition:"{{eq (.Data `layout`) `timeline`}}", then:[
								{do:"add-stream", style:"inline", location:"child", template:"qwerty-timeline-entry", title:"+ Add an Entry"}
							], else:[
								{do:"if", condition:"{{eq (.Data `layout`) `calendar`}}", then:[
									{do:"add-stream", style:"inline", location:"child", template:"qwerty-event", title:"+ Add an Event"}
								], else:[
									{do:"add-stream", style:"inline", location:"child", template:"qwerty-article", title:"+ Add an Article"}
								]}
							]}
						]}
					]}
				]}
			]
		}

		// Drag-and-drop reordering: a Custom collection shows its highest rank first, so its items post in that order
		sort: {
			roles: ["author"]
			steps: [
				// RULE: the direction matches the list's own, or a partial list collides with the rest (see AGENTS.md)
				{do:"if", condition:"{{and (eq (.DataString `layout`) `podcast`) (eq (.DataString `sortDirection`) `asc`)}}", then:[
					{do:"sort", keys:"_id", values:"rank"}
				], else:[
					{do:"sort", keys:"_id", values:"rank", direction:"desc"}
				]}
			]
		}

		delete: {
			roles: ["author"]
			steps: [
				// The Notes and About collections hold nothing, so deleting one only hides its tab (§1.7)
				{do:"delete", title:"Delete '{{.Label}}'?", message:"{{if eq (.Data `layout`) `notes`}}Hide this collection from my profile page.  Existing notes will not be deleted.{{else if eq (.Data `layout`) `about`}}Hide this collection from my profile page.  Your About Me message will not be deleted.{{else}}This deletes the collection and all {{.ChildrenWithDrafts.Count}} items in it, drafts included.  There is NO UNDO.{{end}}"}
				{do:"forward-to", url:"/@me"}
			]
		}
	}
}
