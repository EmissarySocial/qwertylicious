{
	// An entry in a Map (a Place), Timeline, or Calendar (an Event) collection; its forms follow the collection's format.
	templateId: "qwerty-entry"
	category: Content
	templateRole: "entry"
	// Not "Event": nothing federates its dates, and many entries have none
	socialRole: "Note"
	containedBy: ["qwerty-collection"]
	model: Stream
	extends: ["base-intent", "qwerty-common", "qwerty-replies"]
	label: "Qwertylicious Entry"
	description: "A place on a Qwertylicious map, or an event on a timeline or calendar."
	icon: "map-pin"
	tagPaths: ["data.tags"]

	schema: {
		type: "object"
		properties: {
			token: {type:"string"}
			label: {type:"string", maxLength:128}
			summary: {type:"string", maxLength:2048}
			iconUrl: {type:"string", format:"url"}
			startDate: {type:"string"}
			endDate: {type:"string"}
			location: {type:"object", properties: {
				name: {type:"string"}
				formatted: {type:"string"}
				latitude: {type:"number"}
				longitude: {type:"number"}
			}}
			content: {type:"object", properties: {
				format: {type:"string"}
				raw: {type:"string"}
				html: {type:"string", format:"html"}
			}}
			data: {type:"object", properties: {
				iconDescription: {type:"string", maxLength:2048}
				tags: {type:"string", maxLength:1024}
			}}
		}
	}

	states: {
		default: {
			label: "Default State"
			description: "Visible only to Authors and Owners"
		}
		published: {
			label: "Published"
			description: "Visible to all people with permissions"
		}
	}

	roles: {
		viewer: {
			label: "Viewer"
			description: "Can see this entry"
		}
	}

	actions: {

		// Opened inline by the collection's add; add-stream sets the parent first, so the if can read its format
		create: {
			roles: ["author"]
			steps: [
				{do:"as-modal", steps:[
					{do:"if", condition:"{{eq ((.Parent `view`).DataString `layout`) `map`}}", then:[
						{
							do: "edit"
							form: {
								type: "layout-vertical"
								label: "Add a Place"
								children: [
									{type:"text", path:"label", label:"Name", options:{required:true}}
									{type:"place", path:"location", label:"Location", options:{placeholder:"Search for an address or place...", endpoint:"/.geocode/autocomplete", required:true}}
									{type:"textarea", path:"summary", label:"Summary", description:"(PUBLIC) Shows beneath the name.  Markdown is allowed.", options:{rows:2}}
									{type:"text", path:"data.tags", label:"#Hashtags", description:"(PUBLIC) The collection can be filtered by these."}
									{type:"upload", path:"iconUrl", label:"Photo", options:{accept:"image/*"}}
									{type:"textarea", path:"content.raw", label:"Details", description:"(PUBLIC) The full write-up on its own page.  Markdown is allowed.", options:{rows:6}}
								]
							}
						}
					], else:[
						// A Timeline's entries are date-only: the date widget posts YYYY-MM-DD, which is stored at midnight
						{do:"if", condition:"{{eq ((.Parent `view`).DataString `layout`) `timeline`}}", then:[
							{
								do: "edit"
								form: {
									type: "layout-tabs"
									label: "Add an Event"
									children: [
										{
											type: "layout-vertical"
											label: "General"
											children: [
												{type:"text", path:"label", label:"Title", options:{required:true}}
												{type:"date", path:"startDate", label:"Date", options:{required:true, default:"now"}}
												{type:"date", path:"endDate", label:"End Date", description:"Optional, for an event that lasts several days."}
												{type:"place", path:"location", label:"Location", description:"Optional.", options:{placeholder:"Search for an address or place...", endpoint:"/.geocode/autocomplete"}}
											]
										}
										{
											type: "layout-vertical"
											label: "Description"
											children: [
												{type:"textarea", path:"summary", label:"Summary", description:"(PUBLIC) Shows on the timeline and calendar.", options:{rows:2}}
												{type:"textarea", path:"content.raw", label:"Details", description:"(PUBLIC) The full write-up on its own page.  Markdown is allowed.", options:{rows:6}}
												{type:"text", path:"data.tags", label:"#Hashtags", description:"(PUBLIC) The collection can be filtered by these."}
											]
										}
										{
											type: "layout-vertical"
											label: "Photo"
											children: [
												{type:"upload", path:"iconUrl", label:"Photo", options:{accept:"image/*"}}
											]
										}
									]
								}
							}
						], else:[
							{
								do: "edit"
								form: {
									type: "layout-tabs"
									label: "Add an Event"
									children: [
										{
											type: "layout-vertical"
											label: "General"
											children: [
												{type:"text", path:"label", label:"Title", options:{required:true}}
												{type:"datetime", path:"startDate", label:"Starts", options:{required:true, default:"now"}}
												{type:"datetime", path:"endDate", label:"Ends", description:"Leave empty for an event that happens at one moment."}
												{type:"place", path:"location", label:"Location", description:"Optional.", options:{placeholder:"Search for an address or place...", endpoint:"/.geocode/autocomplete"}}
											]
										}
										{
											type: "layout-vertical"
											label: "Description"
											children: [
												{type:"textarea", path:"summary", label:"Summary", description:"(PUBLIC) Shows on the timeline and calendar.", options:{rows:2}}
												{type:"textarea", path:"content.raw", label:"Details", description:"(PUBLIC) The full write-up on its own page.  Markdown is allowed.", options:{rows:6}}
												{type:"text", path:"data.tags", label:"#Hashtags", description:"(PUBLIC) The collection can be filtered by these."}
											]
										}
										{
											type: "layout-vertical"
											label: "Photo"
											children: [
												{type:"upload", path:"iconUrl", label:"Photo", options:{accept:"image/*"}}
											]
										}
									]
								}
							}
						]}
					]}
					{do:"upload-attachments", category:"icon", fieldname:"iconUrl", download-path:"iconUrl", maximum:1, accept-type:"image/*", rules:{width:1200, types:["webp"]}}
					{do:"process-content", format:"MARKDOWN"}
					{do:"save-and-publish", state:"published", outbox:"true"}
					{do:"search-index"}
				]}
				{do:"refresh-page"}
			]
		}

		// An entry's URL opens its modal over its collection's tab
		view: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{do:"include", action:"modal"}
			]
		}

		// Drawn over its Map, Timeline, or Calendar tab, or over its own page if the profile is hidden
		modal: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{
					do: "as-modal"
					background-url: "/@{{(.Parent `view`).ParentID}}?tab={{.ParentID}}"
					background: "page"
					replace-url: "/{{.StreamID}}"
					head: [
						{do:"view-html", file:"head"}
					]
					steps: [
						{do:"view-html", file:"modal"}
					]
				}
			]
		}

		// The entry's own page
		page: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{do:"view-html", file:"view"}
			]
		}

		edit: {
			roles: ["author"]
			steps: [
				{do:"as-modal", steps:[
					// Save and X, top right, in place of the form's own buttons
					{do:"view-html", file:"edit-pencil"}
					{do:"view-html", file:"edit-title"}
					{do:"if", condition:"{{eq ((.Parent `view`).DataString `layout`) `map`}}", then:[
						{
							do: "edit"
							options: ["id:edit-entry-form", "submit-button:hide", "cancel-button:hide", "delete:/{{.StreamID}}/delete", "delete-label:Delete"]
							form: {
								type: "layout-tabs"
								children: [
									{
										type: "layout-vertical"
										label: "General"
										children: [
											{type:"text", path:"label", label:"Name", options:{required:true}}
											{type:"place", path:"location", label:"Location", options:{placeholder:"Search for an address or place...", endpoint:"/.geocode/autocomplete", required:true}}
											{type:"upload", path:"iconUrl", label:"Photo", options:{accept:"image/*", delete:"/{{.ID}}/delete-icon"}}
										]
									}
									{
										type: "layout-vertical"
										label: "Description"
										children: [
											{type:"textarea", path:"summary", label:"Summary", description:"(PUBLIC) Shows beneath the name.  Markdown is allowed.", options:{rows:2}}
											{type:"textarea", path:"content.raw", label:"Details", description:"(PUBLIC) The full write-up on its own page.  Markdown is allowed.", options:{rows:6}}
											{type:"text", path:"data.tags", label:"#Hashtags", description:"(PUBLIC) The collection can be filtered by these."}
										]
									}
								]
							}
						}
					], else:[
						// A Timeline's entries are date-only, as in create
						{do:"if", condition:"{{eq ((.Parent `view`).DataString `layout`) `timeline`}}", then:[
							{
								do: "edit"
								options: ["id:edit-entry-form", "submit-button:hide", "cancel-button:hide", "delete:/{{.StreamID}}/delete", "delete-label:Delete"]
								form: {
									type: "layout-tabs"
									children: [
										{
											type: "layout-vertical"
											label: "General"
											children: [
												{type:"text", path:"label", label:"Title", options:{required:true}}
												{type:"date", path:"startDate", label:"Date", options:{required:true}}
												{type:"date", path:"endDate", label:"End Date", description:"Optional, for an event that lasts several days."}
												{type:"place", path:"location", label:"Location", description:"Optional.", options:{placeholder:"Search for an address or place...", endpoint:"/.geocode/autocomplete"}}
											]
										}
										{
											type: "layout-vertical"
											label: "Description"
											children: [
												{type:"textarea", path:"summary", label:"Summary", description:"(PUBLIC) Shows on the timeline and calendar.", options:{rows:2}}
												{type:"textarea", path:"content.raw", label:"Details", description:"(PUBLIC) The full write-up on its own page.  Markdown is allowed.", options:{rows:6}}
												{type:"text", path:"data.tags", label:"#Hashtags", description:"(PUBLIC) The collection can be filtered by these."}
											]
										}
										{
											type: "layout-vertical"
											label: "Photo"
											children: [
												{type:"upload", path:"iconUrl", label:"Photo", options:{accept:"image/*", delete:"/{{.ID}}/delete-icon"}}
											]
										}
									]
								}
							}
						], else:[
							{
								do: "edit"
								options: ["id:edit-entry-form", "submit-button:hide", "cancel-button:hide", "delete:/{{.StreamID}}/delete", "delete-label:Delete"]
								form: {
									type: "layout-tabs"
									children: [
										{
											type: "layout-vertical"
											label: "General"
											children: [
												{type:"text", path:"label", label:"Title", options:{required:true}}
												{type:"datetime", path:"startDate", label:"Starts", options:{required:true}}
												{type:"datetime", path:"endDate", label:"Ends", description:"Leave empty for an event that happens at one moment."}
												{type:"place", path:"location", label:"Location", description:"Optional.", options:{placeholder:"Search for an address or place...", endpoint:"/.geocode/autocomplete"}}
											]
										}
										{
											type: "layout-vertical"
											label: "Description"
											children: [
												{type:"textarea", path:"summary", label:"Summary", description:"(PUBLIC) Shows on the timeline and calendar.", options:{rows:2}}
												{type:"textarea", path:"content.raw", label:"Details", description:"(PUBLIC) The full write-up on its own page.  Markdown is allowed.", options:{rows:6}}
												{type:"text", path:"data.tags", label:"#Hashtags", description:"(PUBLIC) The collection can be filtered by these."}
											]
										}
										{
											type: "layout-vertical"
											label: "Photo"
											children: [
												{type:"upload", path:"iconUrl", label:"Photo", options:{accept:"image/*", delete:"/{{.ID}}/delete-icon"}}
											]
										}
									]
								}
							}
						]}
					]}
					{do:"upload-attachments", category:"icon", fieldname:"iconUrl", download-path:"iconUrl", maximum:1, action:"replace", accept-type:"image/*", rules:{width:1200, types:["webp"]}}
					{do:"process-content", format:"MARKDOWN"}
					{do:"save", comment:"Updated by {{.Author}}"}
					{do:"search-index"}
				]}
				// Saving returns to the updated entry in its modal; the 303 makes the browser GET it
				{do:"remove-event", event:"closeModal"}
				{do:"redirect-to", method:"post", status:303, url:"/{{.StreamID}}/modal"}
			]
		}

		delete-icon: {
			roles: ["author"]
			steps: [
				{do:"delete-attachments", category:"icon"}
				{do:"set-data", values:{"iconUrl": ""}}
				{do:"save"}
			]
		}

		delete: {
			roles: ["author"]
			steps: [
				{do:"unpublish", state:"default", outbox:"true"}
				{do:"delete", title:"Delete '{{.Label}}'?", message:"This will be removed from your collection.  There is NO UNDO."}
				{do:"forward-to", url:"/{{.ParentID}}"}
			]
		}
	}
}
