{
	// An episode in a Podcast collection (qwerty-collection with data.layout "podcast"), modeled on Bandwagon's
	// songs: a name, a description (Markdown), an optional photo, and one audio track.  The collection's tab lists its
	// episodes (qwerty-collection/items-podcast.html), and each one opens in a modal with its player and its
	// description (modal.html), as a photo opens over its gallery.  It is created and organized only by its
	// collection: the collection's add action opens this template's create form.  Every save writes data.enclosureUrl, which Emissary's feeds turn into an RSS
	// enclosure, so the collection's feed (/{collection}/feed) is the podcast's feed.
	templateId: "qwerty-episode"
	category: Content
	templateRole: "episode"
	socialRole: "Note"
	containedBy: ["qwerty-collection"]
	// Its collection decides who can see it: each save copies the collection's sharing (QWERTY-COLLECTIONS)
	inheritPermissions: true
	model: Stream
	extends: ["base-intent", "qwerty-common", "qwerty-replies"]
	label: "Qwertylicious Podcast Episode"
	description: "An episode of a Qwertylicious podcast."
	icon: "mic"

	schema: {
		type: "object"
		properties: {
			token: {type:"string"}
			label: {type:"string", maxLength:128, required:true}
			iconUrl: {type:"string", format:"url"}
			content: {type:"object", properties: {
				format: {type:"string"}
				raw: {type:"string"}
				html: {type:"string", format:"html"}
			}}
			data: {type:"object", properties: {
				// The audio track: its attachment, its URL (which the upload widget previews), and its filename
				attachmentId: {type:"string"}
				audioUrl: {type:"string", format:"url"}
				attachmentFilename: {type:"string"}
				// What the feeds offer as this episode's enclosure (Emissary's tools/convert/enclosure.go)
				enclosureUrl: {type:"string", format:"url"}
				enclosureType: {type:"string"}
			}}
		}
	}

	states: {
		default: {
			label: "Default State"
			description: "Visible only to Authors and Owners"
		}
		published: {
			label: "Published"
			description: "Visible to all people with permissions"
		}
	}

	roles: {
		viewer: {
			label: "Viewer"
			description: "Can see this episode"
		}
	}

	actions: {

		// Opened through the collection's add action (add-stream, inline), so a GET draws this form in a modal and
		// its POST uploads the files and publishes the episode.  refresh-page reloads the profile on the podcast's
		// tab.  An episode saved without audio is listed but cannot be played, and has no feed enclosure, as a
		// Bandwagon song without a file.  (An inline-error here would not keep the form open: as-modal's POST
		// always closes the modal.)
		create: {
			roles: ["author"]
			steps: [
				{do:"as-modal", steps:[
					{
						do: "edit"
						form: {
							type: "layout-vertical"
							label: "Add an Episode"
							children: [
								{type:"text", path:"label", label:"Name", options:{required:true}}
								{type:"upload", path:"data.audioUrl", label:"Audio", description:"An MP3, M4A, WAV, or other audio file.", options:{accept:"audio/*", filename:"data.attachmentFilename"}}
								{type:"textarea", path:"content.raw", label:"Description", description:"(PUBLIC) Show notes, beneath the episode.  Markdown is okay.", options:{rows:6}}
								{type:"upload", path:"iconUrl", label:"Photo", description:"Optional.  Shown beside the episode, and on lock screens while it plays.", options:{accept:"image/*"}}
							]
						}
					}
					{do:"upload-attachments", action:"replace", category:"Audio", fieldname:"data.audioUrl", attachment-path:"data.attachmentId", download-path:"data.audioUrl", filename-path:"data.attachmentFilename", accept-type:"audio/*", maximum:1}
					{do:"upload-attachments", category:"icon", fieldname:"iconUrl", download-path:"iconUrl", maximum:1, accept-type:"image/*", rules:{width:1200, height:1200, types:["webp"]}}
					{do:"set-data", values:{"data.enclosureUrl":"{{if ne `` (.DataString `attachmentId`)}}{{.Permalink}}/audio?format=mp3{{end}}", "data.enclosureType":"audio/mpeg"}}
					{do:"process-content", format:"MARKDOWN"}
					{do:"save-and-publish", state:"published", outbox:"true"}
					{do:"search-index"}
				]}
				{do:"refresh-page"}
			]
		}

		// An episode's own URL (/{id}) is the one to share.  Opened directly, it draws its podcast's tab on its owner's
		// profile, with the episode as a modal over it and the episode's own title and link-preview tags in <head>
		// (head.html).  A visitor who cannot see that profile gets the episode's own page behind the modal instead.
		// Inside the podcast, a row opens the same modal, and the address bar shows /{id} until it closes.  ParentID
		// is the podcast, and the podcast's ParentID is its owner.
		view: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{do:"include", action:"modal"}
			]
		}

		modal: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{
					do: "as-modal"
					background-url: "/@{{(.Parent `view`).ParentID}}?tab={{.ParentID}}"
					background: "page"
					replace-url: "/{{.StreamID}}"
					head: [
						{do:"view-html", file:"head"}
					]
					steps: [
						{do:"view-html", file:"modal"}
					]
				}
			]
		}

		// The episode as a page of its own, behind the modal when its podcast cannot be drawn
		page: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{do:"view-html", file:"view"}
			]
		}

		// Replacing the audio keeps the episode's URL, and its feed enclosure, the same
		edit: {
			roles: ["author"]
			steps: [
				{do:"as-modal", steps:[
					{
						do: "edit"
						options: ["delete:/{{.StreamID}}/delete", "delete-label:Delete"]
						form: {
							type: "layout-vertical"
							label: "Edit Episode"
							children: [
								{type:"text", path:"label", label:"Name", options:{required:true}}
								{type:"upload", path:"data.audioUrl", label:"Audio", description:"Choose a file to replace this episode's audio.", options:{accept:"audio/*", filename:"data.attachmentFilename"}}
								{type:"textarea", path:"content.raw", label:"Description", description:"(PUBLIC) Show notes, beneath the episode.  Markdown is okay.", options:{rows:6}}
								{type:"upload", path:"iconUrl", label:"Photo", description:"Optional.  Shown beside the episode, and on lock screens while it plays.", options:{accept:"image/*", delete:"/{{.StreamID.Hex}}/delete-icon"}}
							]
						}
					}
					{do:"upload-attachments", action:"replace", category:"Audio", fieldname:"data.audioUrl", attachment-path:"data.attachmentId", download-path:"data.audioUrl", filename-path:"data.attachmentFilename", accept-type:"audio/*", maximum:1}
					{do:"upload-attachments", action:"replace", category:"icon", fieldname:"iconUrl", download-path:"iconUrl", maximum:1, accept-type:"image/*", rules:{width:1200, height:1200, types:["webp"]}}
					{do:"set-data", values:{"data.enclosureUrl":"{{if ne `` (.DataString `attachmentId`)}}{{.Permalink}}/audio?format=mp3{{end}}", "data.enclosureType":"audio/mpeg"}}
					{do:"process-content", format:"MARKDOWN"}
					{do:"save", comment:"Updated by {{.Author}}"}
					{do:"search-index"}
				]}
				{do:"refresh-page"}
			]
		}

		// The edit form's photo preview removes the photo (the upload widget's delete option)
		delete-icon: {
			roles: ["author"]
			steps: [
				{do:"delete-attachments", category:"icon"}
				{do:"set-data", values:{"iconUrl": ""}}
				{do:"save", comment:"Photo removed by {{.Author}}"}
			]
		}

		delete: {
			roles: ["author"]
			steps: [
				{do:"unpublish", state:"default", outbox:"true"}
				{do:"delete", title:"Delete '{{.Label}}'?", message:"This episode and its audio will be removed from your podcast.  There is NO UNDO."}
				{do:"forward-to", url:"/{{.ParentID}}"}
			]
		}

		// The episode's audio, transcoded on request, as the players and the feed enclosure ask for it, with the
		// episode's name, its podcast's name, and its photo (or its podcast owner's) written into the file's tags
		audio: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{
					do: "view-attachment"
					category: "Audio"
					format: ["mp3", "ogg"]
					bitrate: 128
					cache: false
					metadata: [
						{first:"cover", rules:[
							{target:"cover", path:"stream.iconUrl"}
							{target:"cover", path:"parent.attributedTo.iconUrl"}
						]}
						{target:"title", path:"stream.name"}
						{target:"artist", path:"parent.attributedTo.name"}
						{target:"album_artist", path:"parent.attributedTo.name"}
						{target:"album", path:"parent.name"}
						{target:"comment", path:"parent.attributedTo.profileUrl"}
						{target:"genre", value:"Podcast"}
					]
				}
			]
		}
	}
}
