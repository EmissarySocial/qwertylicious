{
	templateId:"qwerty-article"
	category: Content
	templateRole:"article"
	socialRole:"Article"
	containedBy: ["qwerty-collection"]
	model: Stream
	extends:["base-intent", "qwerty-replies", "qwerty-item-base"]
	tagPaths:["data.tags"]
	label:"Qwertylicious Article"
	description:"Articles show up on a Qwertylicious user's profile page."
	bundles: {
		stylesheet: {
			content-type:"text/css"
		}
	}
	schema: {
		type:"object"
		properties: {
			icon:{type:"string"}
			token: {type:"string", required:true}
			name: {type:"string"}
			summary: {type:"string"}
			// RULE: content restates no property, so raw and html keep Emissary's definitions (see AGENTS.md)
			content:{type:"object", properties: {}}
			data: {type:"object", properties: {
				tags: {type:"string"}
				iconDescription: {type:"string", maxLength:2048}
				bannerUrl: {type:"string", format:"url"}
				bannerId: {type:"string", format:"objectId"}
				bannerDescription: {type:"string", maxLength:2048}
			}}
		}
	}
	states: {
		default: {
			label:"Default State"
			description:"Visible only to Authors and Owners"
		}
		published: {
			label:"Published"
			description:"Visible to all people with permissions"
		}
	}
	roles: {
		viewer: {
			label:"Viewer"
			description:"Can read full content of this article."
		}
	}
	actions: {

		create:{
			roles: ["author"]
			steps: [
				{do:"set-data", values:{"name":"New Article Title", "content.format":"EDITORJS", "content.raw":"{\"time\":0,\"blocks\":[{\"type\":\"paragraph\",\"data\":{\"text\":\"Enter your article text here...\"}}],\"version\":\"2.31.5\"}"}}
				{do:"save"}
				{do:"forward-to", url: "/{{.StreamID}}/edit"}
			]
		}


		view: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps:[
				{do:"view-html"}
			]
		}

		view-premium: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps:[
				{do:"view-html"}
			]
		}

		edit: {
			roles: ["author"]
			steps: [
				{do:"view-html"}
			]
		}

		edit-banner: {
			roles: ["author"]
			steps: [
				{do:"view-html"}
			]
		}

		// RULE: the stored format picks the editor's save step; edit-content.html and properties name the same three (see AGENTS.md)
		edit-content: {
			roles: ["author"]
			steps: [
				{do:"switch", expression:"{{.ContentFormat}}", cases:{
					MARKDOWN: {do:"edit-content", format:"MARKDOWN"}
					HTML: {do:"edit-content", format:"HTML"}
				}, default:{do:"edit-content", format:"EDITORJS"}}
				{do:"process-content", add-links:false, remove-html:false}
				{do:"save"}
			]
		}

		delete: {
			roles: ["author"]
			steps: [
				{do:"unpublish", state:"default", outbox:"true"}
				{do:"delete", title:"Delete '{{.Label}}'?", message:"All content and comments will be lost.  There is NO UNDO."}
				{do:"forward-to", url:"/{{.ParentID}}"}
			]
		}
						
		
		publish: {
			states: ["default", "published"]
			roles: ["author"]
			steps: [
				{do:"as-confirmation", title:"Publish this Article?", message:"Viewers will be able to see this article on your profile.", submit:"Publish"}
				{do:"save-and-publish", state:"published", outbox:"true"}
				{do:"search-index"}
				{do:"forward-to", url:"/{{.StreamID}}"}
			]
		}
		
		unpublish: {
			states: ["published"]
			roles: ["author"]
			steps: [
				{do:"as-confirmation", title:"Un-Publish this Article?", message:"This article will remain on your profile, but viewers will no longer be able to see it", submit:"Un-Publish"}
				{do:"unpublish", state:"default", outbox:"true"}
				{do:"refresh-page"}
			]
		}
						
		properties: {
			roles: ["author"]
			steps: [
				{do:"as-modal", steps:[
					// The format before the form applies, counting anything but MARKDOWN and HTML as EDITORJS, as edit-content does
					{do:"set-args", previousFormat:"{{if in .ContentFormat `MARKDOWN` `HTML`}}{{.ContentFormat}}{{else}}EDITORJS{{end}}"}
					// RULE: a Custom collection ignores Featured, so its Articles offer no Feature toggle (see AGENTS.md)
					{do:"if", condition:"{{eq ((.Parent `view`).DataString `sortType`) `rank`}}", then:[
						{
							do: edit
							options: ["delete:/{{.StreamID}}/delete", "delete-label:Delete"]
							form: {
								type: layout-tabs
								label: Article Properties
								children: [
									{
										type:"layout-vertical"
										label:"General"
										children: [
											{type:"text", path:"name", label:"Title", description:"(PUBLIC) Shows in your news feed and at the top of the post."}
											{type:"text", path:"token", label:"URL Token", description:"(PUBLIC) Appears as the URL for this post (MUST BE UNIQUE)", options:{validator:"/.validate/stream/token?streamId={{.ID}}"}}
											{type:"select", path:"content.format", label:"Format", description:"Changing the format will erase this article's text.", options:{required:true, enum:[
												{value:"EDITORJS", label:"Visual Editor"}
												{value:"MARKDOWN", label:"Markdown"}
												{value:"HTML", label:"HTML"}
											]}}
										]
									}
									{
										type:layout-vertical
										label:"Description"
										children:[
											{type:"textarea", path:"summary", description:"(PUBLIC) Shows beneath the post title.", options:{rows:10}}
										]
									}
									{
										type:layout-vertical
										label:"Hashtags"
										children:[
											// The article's hashtags as checkboxes, with no label or description of its own (see AGENTS.md)
											{type:"html-remote", path:"data.tags", options:{url:"/{{.ID}}/tag-options"}}
										]
									}
									{
										type:layout-vertical
										label:"Icon"
										children:[
											{type:"upload", path:"iconUrl", label:"Icon Image", description:"Shows on article lists. Aspect Ratio: square", options:{accept:"image/*", delete:"/{{.ID}}/delete-icon"}}
											{type:"textarea", path:"data.iconDescription", label:"Icon Description", description:"'Alt text' for screen readers and SEO", options:{rows:4}}
										]
									}
									{
										type:layout-vertical
										label:"Banner"
										children:[
											{type:"upload", path:"data.bannerUrl", label:"Banner Image", description:"Shows on top of article page. Aspect Ratio: 16x9", options:{accept:"image/*", delete:"/{{.ID}}/delete-banner"}}
											{type:"textarea", path:"data.bannerDescription", label:"Banner Description", description:"'Alt text' for screen readers and SEO", options:{rows:4}}
										]
									}
								]
							}
						}
					], else:[
						{
							do: edit
							options: ["delete:/{{.StreamID}}/delete", "delete-label:Delete"]
							form: {
								type: layout-tabs
								label: Article Properties
								children: [
									{
										type:"layout-vertical"
										label:"General"
										children: [
											{type:"text", path:"name", label:"Title", description:"(PUBLIC) Shows in your news feed and at the top of the post."}
											{type:"text", path:"token", label:"URL Token", description:"(PUBLIC) Appears as the URL for this post (MUST BE UNIQUE)", options:{validator:"/.validate/stream/token?streamId={{.ID}}"}}
											{type:"select", path:"content.format", label:"Format", description:"Changing the format will erase this article's text.", options:{required:true, enum:[
												{value:"EDITORJS", label:"Visual Editor"}
												{value:"MARKDOWN", label:"Markdown"}
												{value:"HTML", label:"HTML"}
											]}}
											{type:"toggle", path:"isFeatured", options:{false-text:"Feature?", true-text:"Featured"}}
										]
									}
									{
										type:layout-vertical
										label:"Description"
										children:[
											{type:"textarea", path:"summary", description:"(PUBLIC) Shows beneath the post title.", options:{rows:10}}
										]
									}
									{
										type:layout-vertical
										label:"Hashtags"
										children:[
											// The article's hashtags as checkboxes, with no label or description of its own (see AGENTS.md)
											{type:"html-remote", path:"data.tags", options:{url:"/{{.ID}}/tag-options"}}
										]
									}
									{
										type:layout-vertical
										label:"Icon"
										children:[
											{type:"upload", path:"iconUrl", label:"Icon Image", description:"Shows on article lists. Aspect Ratio: square", options:{accept:"image/*", delete:"/{{.ID}}/delete-icon"}}
											{type:"textarea", path:"data.iconDescription", label:"Icon Description", description:"'Alt text' for screen readers and SEO", options:{rows:4}}
										]
									}
									{
										type:layout-vertical
										label:"Banner"
										children:[
											{type:"upload", path:"data.bannerUrl", label:"Banner Image", description:"Shows on top of article page. Aspect Ratio: 16x9", options:{accept:"image/*", delete:"/{{.ID}}/delete-banner"}}
											{type:"textarea", path:"data.bannerDescription", label:"Banner Description", description:"'Alt text' for screen readers and SEO", options:{rows:4}}
										]
									}
								]
							}
						}
					]}
					// RULE: a new format starts empty, except HTML, which starts from the rendered text (see AGENTS.md)
					{do:"if", condition:"{{$format := `EDITORJS`}}{{if in .ContentFormat `MARKDOWN` `HTML`}}{{$format = .ContentFormat}}{{end}}{{ne $format (.GetString `previousFormat`)}}", then:[
						{do:"if", condition:"{{eq .ContentFormat `HTML`}}", then:[
							{do:"set-data", values:{"content.raw":"{{.ContentHTML}}"}}
						], else:[
							{do:"set-data", values:{"content.raw":"", "content.html":""}}
						]}
						{do:"refresh-page"}
					]}
					{do:"upload-attachments", category:"icon", fieldname:"iconUrl", download-path:"iconUrl", description-fieldname:"data.iconDescription", accept-type:"image/*", rules:{width:800, height:800, types:["webp"]}}
					{do:"upload-attachments", category:"banner", fieldname:"data.bannerUrl",attachment-path:"data.bannerId",  download-path:"data.bannerUrl", description-fieldname:"data.bannerDescription", accept-type:"image/*"}
					{do:"save", comment:"Properties updated by {{.Author}}"}
					{do:"trigger-event", event:"refreshBanner"}
				]}
			]
		}

		delete-icon: {
			roles: ["author"]
			steps: [
				{do: "delete-attachments", category:"icon"}
				{do: "set-data", values:{"iconUrl": ""}}
				{do: "save"}
			]
		}

		upload-banner: {
			roles: ["author"]
			steps: [
				{do: "upload-attachments", category:"banner", fieldname:"image", attachment-path:"data.bannerId", download-path:"data.bannerUrl", accept-type:"image/*"}
				{do: "save"}
				{do: "trigger-event", event:"refreshBanner"}
			]
		}
		
		delete-banner: {
			roles: ["author"]
			steps: [
				{do: "as-confirmation", title:"Remove Banner Image?", message:"This banner will be permanently removed from your article.  There is NO UNDO.", submit:"Remove"}
				{do: "delete-attachments", category:"banner"}
				{do: "set-data", values:{"data.bannerUrl": ""}}
				{do: "save"}
				{do: "trigger-event", event:"refreshBanner"}
			]
		}

		upload-image: {
			roles: ["author"]
			steps: [
				{do: "upload-attachments", fieldname:"image", maximum:32, json-result:true, category:"image", accept-type:"image/*"}
				{do: "save"}
				{do: "trigger-event", event:"refreshBanner"}
			]
		}	

		intent: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps:[
				{do:"as-modal", steps:[
					{do:"view-html"}
				]}
			]
		}
	}
}
