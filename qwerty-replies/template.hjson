{
	// qwerty-replies is the Replies widget shared by every collection item (qwerty-article, qwerty-photo,
	// qwerty-entry), which list it in their "extends".  It adds a Replies tab beside the item's own content,
	// lists the replies its Stream has accepted, and offers visitors a Reply button that sends them, through an
	// Activity Intent (base-intent's "intent" action), to reply from their own Fediverse account.
	//
	// Whether an item accepts replies is its Stream's replyPolicy, which the item inherits from its collection
	// with its sharing (inheritPermissions).  Emissary records a reply only when the Stream AcceptsReplies: it is
	// public, and its policy is not "nobody".  The list reads that record (ReplyLinksAfter), so a reply that
	// arrived while replies were closed never shows.
	//
	// Partials, called from the item's views:
	//   replies-tabs   (array $builder $label $mode): the tab bar.  $label names the first tab ("Article"), and
	//                  $mode is "page" for a full page or "modal" for a modal (the photo modal).
	//   replies-panel  $builder: the Replies tab's content.
	templateId: "qwerty-replies"
	category: Base
	model: None
	// base-social supplies hidden-placeholder, for a reply the viewer's own rules hide
	extends: ["base-social"]

	// Emissary validates each template's actions on their own, so the state and role its actions name are
	// defined here too.  Every item template defines both itself, and its own definitions win.
	states: {
		published: {
			label: "Published"
			description: "Visible to all people with permissions"
		}
	}

	roles: {
		viewer: {
			label: "Viewer"
			description: "Can see this item and its replies"
		}
	}

	actions: {

		// The next page of replies, loaded by the list's "revealed" sentinel (?after=createDate)
		replies-list: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{do:"view-html"}
			]
		}

		// One reply (?id=), re-drawn with ?reveal=true when a visitor shows a reply their rules hide
		reply: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{do:"view-html"}
			]
		}
	}
}
