			{label:"Calendar", value:"calendar", icon:"calendar3", description:"Coming soon"}
		]

		fonts: [
			{Label:"System Fonts", Group:"Sans Serif", Value:"system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol'"}
