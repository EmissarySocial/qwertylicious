{
	templateId: qwerty-common
	category: Content
	model: None
	label: Qwerty Common
	description: Common element for Qwertylicious apps
	extends: []
	containedBy: []

	states: {
		default: {
			label: Default
			description: Default state for Qwerty Common
		}
	}

	datasets: {
		colors: [
			{Label:"Red", Value:"#ea3829"}
			{Label:"Orange", Value:"#f68511"}
			{Label:"Yellow", Value:"#f8d904"}
			{Label":"Light Green", Value:"#aad816"}
			{Label:"Green", Value:"#27bb36"}
			{Label:"Dark Green", Value:"#008f5d"}
			{Label:"Teal", Value:"#0fb5ae"}
			{Label:"Cyan", Value:"#33c5e8"}
			{Label:"Blue", Value:"#3892f3"}
			{Label:"Indigo", Value:"#686df4"}
			{Label:"Purple", Value:"#893de7"}
			{Label:"Pink", Value:"#e055e2"}
			{Label:"Magenta", Value: "#de3d82"}
			{Label:"Gray", Value:"#888888"}
		]
		layouts: [
			{label:"Notes", value:"notes", icon:"chat-square-text", description:"Short posts, newest first, with a box to write one"}
			{label:"Articles", value:"column-3", icon:"journal-text", description:"Long-form posts, shown as cards"}
			{label:"Photos", value:"gallery", icon:"images", description:"A grid of photos, newest first"}
			{label:"Podcast", value:"podcast", icon:"mic", description:"Audio episodes, each opening in its own player"}
			{label:"Timeline", value:"timeline", icon:"clock-history", description:"Events in date order, by year"}
			{label:"Calendar", value:"calendar", icon:"calendar3", description:"Events in a month, week, or list view"}
			{label:"Map", value:"map", icon:"map", description:"Places, each a marker on one large map"}
		]

		// Add a Collection offers these once the profile has its one Notes collection.  Keep them in step with layouts.
		layoutsWithoutNotes: [
			{label:"Articles", value:"column-3", icon:"journal-text", description:"Long-form posts, shown as cards"}
			{label:"Photos", value:"gallery", icon:"images", description:"A grid of photos, newest first"}
			{label:"Podcast", value:"podcast", icon:"mic", description:"Audio episodes, each opening in its own player"}
			{label:"Timeline", value:"timeline", icon:"clock-history", description:"Events in date order, by year"}
			{label:"Calendar", value:"calendar", icon:"calendar3", description:"Events in a month, week, or list view"}
			{label:"Map", value:"map", icon:"map", description:"Places, each a marker on one large map"}
		]

		// Edit Collection offers these to an Article collection, so its format can change only among the ones that hold Articles
		articleLayouts: [
			{label:"1x Column", value:"column-1", icon:"view-stacked", description:"Large cards take up the full page width"}
			{label:"2x Columns", value:"column-2", icon:"grid", description:"Medium cards are arranged in two columns"}
			{label:"3x Columns", value:"column-3", icon:"grid-3x2-gap", description:"Small cards are arranged in three columns"}
			{label:"Rows", value:"row", icon:"list-columns-reverse", description:"Cards with descriptions to the right side of the image"}
			{label:"Rows Reversed", value:"row-reverse", icon:"list-columns", description:"Cards with descriptions to the left side of the image"}
		]

		timelineOrders: [
			{label:"Oldest First", value:"asc", icon:"sort-up", description:"Starts at the beginning, like a history"}
			{label:"Newest First", value:"desc", icon:"sort-down", description:"Starts with the latest, like a feed"}
		]

		// A Podcast's episode order.  Empty is treated as newest first.
		episodeOrders: [
			{label:"Newest First", value:"desc", icon:"sort-down", description:"The latest episode leads, like a feed"}
			{label:"Oldest First", value:"asc", icon:"sort-up", description:"Starts at episode one, for a series heard in order"}
		]

		// A Calendar's default view, in the toolbar's order
		calendarViews: [
			{label:"List", value:"list", icon:"list-ul", description:"One month's events, one row each"}
			{label:"Week", value:"week", icon:"calendar-week", description:"Seven days, Sunday first"}
			{label:"Month", value:"month", icon:"calendar3", description:"A grid of the whole month"}
		]

		// A new Map's starting zoom, from Leaflet's 0 (the world) to 19 (a building)
		mapZooms: [
			{label:"World", value:"2"}
			{label:"Continent", value:"3"}
			{label:"Country", value:"5"}
			{label:"Region", value:"8"}
			{label:"City", value:"11"}
			{label:"Neighborhood", value:"14"}
			{label:"Street", value:"16"}
		]

		fonts: [
			{Label:"System Fonts", Group:"Sans Serif", Value:"system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol'"}
			{Label:"Merriweather Sans", Group:"Sans Serif", Value:"Merriweather Sans"}
			{Label:"Oxygen", Group:"Sans Serif", Value:"Oxygen"}
			{Label:"Fira Sans", Group:"Sans Serif", Value:"Fira Sans"}
			{Label:"Noto", Group:"Sans Serif", Value:"Noto *"}
			{Label:"Baskerville", Group:"Serif", Value:"Baskerville"}
			{Label:"Spectral", Group:"Serif", Value:"Spectral"}
			{Label:"Newsreader", Group:"Serif", Value:"Newsreader"}
			{Label:"Playfair Display", Value:"Playfair Display"}
			{Label:"Cormorant *", Group:"Serif", Value:"Cormorant *"}
			{Label:"Merriweather", Group:"Serif", Value:"Merriweather"}
			{Label:"Source Serif", Group:"Fixed Width", Value:"Source Serif"}
			{Label:"Oxygen Mono", Group:"Fixed Width", Value:"Oxygen Mono"}
		]
	}
}