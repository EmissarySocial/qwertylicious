{
	// A post of 1 to 16 photos in a Photo Gallery; published at once, and opened in a modal.
	templateId: "qwerty-photo"
	category: Content
	templateRole: "photo"
	socialRole: "Note"
	containedBy: ["qwerty-collection"]
	model: Stream
	extends: ["base-intent", "qwerty-replies"]
	label: "Qwertylicious Photo"
	description: "A photo in a Qwertylicious photo gallery."
	icon: "image"
	// A photo's own hashtags, which its gallery's filters match
	tagPaths: ["data.tags"]

	schema: {
		type: "object"
		properties: {
			token: {type:"string"}
			label: {type:"string", maxLength:128}
			iconUrl: {type:"string", format:"url"}
			content: {type:"object", properties: {
				format: {type:"string"}
				raw: {type:"string", format:"markdown", maxLength:4096}
				html: {type:"string", format:"html"}
			}}
			isFeatured: {type:"boolean"}
			data: {type:"object", properties: {
				photoCount: {type:"integer", minimum:0, maximum:16}
				tags: {type:"string", maxLength:1024}
			}}
		}
	}

	states: {
		default: {
			label: "Default State"
			description: "Visible only to Authors and Owners"
		}
		published: {
			label: "Published"
			description: "Visible to all people with permissions"
		}
	}

	roles: {
		viewer: {
			label: "Viewer"
			description: "Can see this photo"
		}
	}

	actions: {

		// Opened inline by the collection's add; each photo is staged under the User as it is dropped, through the photos action reached before the Save, and the POST adopts them through the same action and publishes the post
		create: {
			roles: ["author"]
			steps: [
				{do:"as-modal", options:["class:medium"], steps:[
					// The same two tabs as Edit Photo below; a change to one form is a change to both
					{
						do: "edit"
						form: {
							type: "layout-tabs"
							label: "Add Image"
							children: [
								{
									type: "layout-vertical"
									label: "Images"
									children: [
										// The post has no route yet, so the photos action is reached through the collection's add, which stages each photo under the User
										{type:"html-remote", label:"Photos", description:"Add up to 16 files. Recommended size maximum 2000x2000 pixels.", options:{url:"/{{.ParentID.Hex}}/add?action=photos"}}
										{type:"toggle", path:"isFeatured", options:{true-text:"Pinned to top", false-text:"Pin to top"}}
									]
								}
								{
									type: "layout-vertical"
									label: "Text Content"
									children: [
										{type:"text", path:"label", label:"Title", description:"(PUBLIC) Optional.  Shows above the description."}
										{type:"textarea", path:"content.raw", label:"Description", description:"Describe your image here.  Markdown is okay.", options:{rows:10}}
										{type:"text", path:"data.tags", label:"Hashtags", description:"Enter #Hashtags separated by spaces. Filters items in the collection index."}
									]
								}
							]
						}
					}
					// The include lets the photos action run on the unsaved post before the Save, and adopts the staged photos at it
					{do:"include", action:"photos"}
					{do:"process-content", format:"MARKDOWN"}
					{do:"save-and-publish", state:"published", outbox:"true"}
					{do:"search-index"}
				]}
				{do:"refresh-page"}
			]
		}

		// The post's photos, which the html-remote element on Create and Edit Photo loads and changes in place
		photos: {
			roles: ["author"]
			steps: [
				{do:"edit-attachments", category:"photo", fieldname:"photos", accept-type:"image/*", minimum:1, maximum:16, rules:{types:["webp"]}}
				// The first photo is the post's thumbnail, so every change re-picks it and recounts
				{do:"set-thumbnail", path:"iconUrl", category:"photo"}
				{do:"set-data", values:{"data.photoCount":"{{len (.AttachmentsByCategory `photo`)}}"}}
				{do:"save", comment:"Photos updated by {{.Author}}"}
			]
		}

		// The photo's shareable URL: its modal over the gallery, or over its own page if the profile is hidden
		view: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{do:"include", action:"modal"}
			]
		}

		modal: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{
					do: "as-modal"
					options: ["class:large"]
					background-url: "/@{{(.Parent `view`).ParentID}}?tab={{.ParentID}}"
					background: "page"
					replace-url: "/{{.StreamID}}"
					head: [
						{do:"view-html", file:"head"}
					]
					steps: [
						{do:"view-html", file:"modal"}
					]
				}
			]
		}

		// The Replies, Likes, and Shares tabs under the item, redrawn in place when a tab is clicked (?tab=)
		responses: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{do:"view-html"}
			]
		}

		// The photo's own page, behind the modal when its gallery cannot be drawn
		page: {
			roles: ["author"]
			stateRoles: {
				published: ["viewer"]
			}
			steps: [
				{do:"view-html", file:"view"}
			]
		}

		edit: {
			roles: ["author"]
			steps: [
				{do:"as-modal", options:["class:medium"], steps:[
					// Save and X, top right, in place of the form's own buttons
					{do:"view-html", file:"edit-pencil"}
					// RULE: a Custom gallery ignores pins, so its photos offer no Pin toggle (see AGENTS.md)
					{do:"if", condition:"{{eq ((.Parent `view`).DataString `sortType`) `rank`}}", then:[
						{
							do: "edit"
							options: ["id:edit-photo-form", "submit-button:hide", "cancel-button:hide", "delete:/{{.StreamID}}/delete", "delete-label:Delete"]
							form: {
								type: "layout-tabs"
								label: "Edit Image"
								children: [
									{
										type: "layout-vertical"
										label: "Images"
										children: [
											{type:"html-remote", label:"Photos", description:"Add up to 16 files. Recommended size maximum 2000x2000 pixels.", options:{url:"/{{.ID}}/photos"}}
										]
									}
									{
										type: "layout-vertical"
										label: "Text Content"
										children: [
											{type:"text", path:"label", label:"Title", description:"(PUBLIC) Optional.  Shows above the description."}
											{type:"textarea", path:"content.raw", label:"Description", description:"Describe your image here.  Markdown is okay.", options:{rows:10}}
											{type:"text", path:"data.tags", label:"Hashtags", description:"Enter #Hashtags separated by spaces. Filters items in the collection index."}
										]
									}
								]
							}
						}
					], else:[
						{
							do: "edit"
							options: ["id:edit-photo-form", "submit-button:hide", "cancel-button:hide", "delete:/{{.StreamID}}/delete", "delete-label:Delete"]
							form: {
								type: "layout-tabs"
								label: "Edit Image"
								children: [
									{
										type: "layout-vertical"
										label: "Images"
										children: [
											{type:"html-remote", label:"Photos", description:"Add up to 16 files. Recommended size maximum 2000x2000 pixels.", options:{url:"/{{.ID}}/photos"}}
											{type:"toggle", path:"isFeatured", options:{true-text:"Pinned to top", false-text:"Pin to top"}}
										]
									}
									{
										type: "layout-vertical"
										label: "Text Content"
										children: [
											{type:"text", path:"label", label:"Title", description:"(PUBLIC) Optional.  Shows above the description."}
											{type:"textarea", path:"content.raw", label:"Description", description:"Describe your image here.  Markdown is okay.", options:{rows:10}}
											{type:"text", path:"data.tags", label:"Hashtags", description:"Enter #Hashtags separated by spaces. Filters items in the collection index."}
										]
									}
								]
							}
						}
					]}
					// The photos are already saved: the widget changes them in place through the photos action
					{do:"process-content", format:"MARKDOWN"}
					{do:"save", comment:"Updated by {{.Author}}"}
				]}
				// Saving returns to the updated photo in its modal; the 303 makes the browser GET it
				{do:"remove-event", event:"closeModal"}
				{do:"redirect-to", method:"post", status:303, url:"/{{.StreamID}}/modal"}
			]
		}

		delete: {
			roles: ["author"]
			steps: [
				{do:"unpublish", state:"default", outbox:"true"}
				{do:"delete", title:"Delete this Photo?", message:"The photo and its caption will be removed from your gallery.  There is NO UNDO."}
				{do:"forward-to", url:"/{{.ParentID}}"}
			]
		}

	}
}
